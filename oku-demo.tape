Output oku-demo.gif
Output oku-demo.mp4
Set FontSize 18
Set Width 1400
Set Height 1000
Set Theme "GruvboxDark"
Set TypingSpeed 65ms
Set Padding 20
Set Framerate 15

Type "oku"
Enter
Sleep 3s

# Browse the sample reading library. The detail pane follows the cursor.
Type "j"
Sleep 1s
Type "j"
Sleep 1s
Type "k"
Sleep 1s

# Enter moves the keyboard into the detail pane; Escape brings it back.
Enter
Sleep 2s
Escape
Sleep 1s

# Want-to-read shelf: tab 2.
Type "l"
Sleep 2s
Type "j"
Sleep 1s

# Past the Search tab (3) to the statistics (4); no live search is made.
Type "ll"
Sleep 4s

# The Timer tab (5): open its local book picker, then cancel.
Type "l"
Sleep 2s
Type "t"
Sleep 2s
Type "j"
Sleep 1s
Escape
Sleep 1s

# End on the reading library.
Type "hhhh"
Sleep 3s
