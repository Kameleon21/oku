Output oku-demo.gif
Output oku-demo.mp4
Set FontSize 18
Set Width 1400
Set Height 1000
Set Theme "GruvboxDark"
Set TypingSpeed 65ms
Set Padding 20
Set Framerate 15

Type "oku"
Enter
Sleep 3s

# Browse the sample reading library.
Type "j"
Sleep 1s
Type "j"
Sleep 1s
Type "k"
Sleep 1s

# Want-to-read shelf.
Type "l"
Sleep 2s
Type "j"
Sleep 1s

# Skip live search; show local demo statistics.
Type "ll"
Sleep 4s

# Open the timer's local book picker, then cancel.
Type "l"
Sleep 2s
Type "t"
Sleep 2s
Type "j"
Sleep 1s
Escape
Sleep 1s

# End on the reading library.
Type "hhhh"
Sleep 3s
